{
  "name": "dispatch",
  "version": "1.0.0",
  "description": "The open-source collaborative inbox for teams — shared Gmail & IMAP inboxes, internal comments, assignments and automation.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/codextde/dispatch",
  "repository": {
    "type": "git",
    "url": "https://github.com/codextde/dispatch.git"
  },
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch --conditions=react-server --tsconfig tsconfig.json src/worker/index.ts",
    "build": "next build && pnpm build:worker",
    "build:worker": "node scripts/build-worker.mjs",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --conditions=react-server scripts/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "services": "docker compose -f docker-compose.dev.yml up -d",
    "dev:session": "tsx --conditions=react-server scripts/dev-session.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1152.0",
    "@aws-sdk/s3-request-presigner": "^3.1152.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.104.3",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-mention": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
    "@tiptap/extension-underline": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/react": "^3.32.0",
    "@tiptap/starter-kit": "^3.32.0",
    "@tiptap/suggestion": "^3.32.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "frimousse": "^0.4.0",
    "geist": "^1.8.1",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.5.2",
    "input-otp": "^1.5.0",
    "isomorphic-dompurify": "^4.5.0",
    "lucide-react": "^1.58.0",
    "mailparser": "^3.9.40",
    "marked": "^18.1.1",
    "motion": "^13.4.4",
    "nanoid": "^6.0.2",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.2",
    "postgres": "^3.4.9",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.1",
    "react-resizable-panels": "^4.14.5",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.5",
    "sonner": "^2.0.8",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "ua-parser-js": "^2.0.10",
    "vaul": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/html-to-text": "^9.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^24.19.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@9.15.0"
}
